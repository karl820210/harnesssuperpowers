#!/usr/bin/env bash
# spec-scan-check — PostToolUse reminder: when a Phase spec file is edited, nudge the
# agent to run spec-scan next turn.
#
# Input: hook event JSON is on stdin (Claude Code) or env vars (Cursor).
# Output: JSON envelope matching the current platform; empty `{}` if not a spec.

set -euo pipefail

is_spec_path() {
    case "$1" in
        *'/specs/'*'/prd.md') return 0 ;;
        *'/specs/'*'/sysdesign.md') return 0 ;;
        *'/specs/'*'/tasks.md') return 0 ;;
        .kiro/specs/*/*.md) return 0 ;;
        *) return 1 ;;
    esac
}

# Try to extract a file path hint from env / stdin.
# Cursor provides env vars such as CURSOR_CHANGED_FILE and never reaches the
# stdin read below (so its "open-but-empty stdin" quirk cannot block us here).
# Claude Code — and stdin-JSON runners generally — pipe the hook event JSON
# and close stdin, so a plain `cat` cannot block.
# (Previously a python select() probe guarded this read; on Windows select()
# only supports sockets, so it always failed on the pipe, the path was never
# extracted, and the filter below degraded into reminding on every edit.)
changed_file="${CURSOR_CHANGED_FILE:-}"
if [ -z "$changed_file" ] && [ ! -t 0 ]; then
    # Use sed -n with a print flag so no-match exits 0 (safe under pipefail).
    stdin_data=$(cat 2>/dev/null || true)
    changed_file=$(printf '%s' "$stdin_data" | sed -nE 's/.*"file_path"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' | head -n1)
fi

if [ -n "$changed_file" ] && ! is_spec_path "$changed_file"; then
    # Not a spec edit — silent no-op.
    echo '{}'
    exit 0
fi

context='<system_reminder>A Phase spec file was just edited. Before continuing, consider running `superpowers:spec-scan` on the Phase folder to check: PRD completeness, Interface Contracts, CP-xx Correctness Properties, Wiring Matrix presence, Latent/Deterministic tagging, and cross-file consistency. Skip if this edit was cosmetic.</system_reminder>'

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
    printf '{"additional_context":"%s"}\n' "$context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
    printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":"%s"}}\n' "$context"
else
    printf '{"additionalContext":"%s"}\n' "$context"
fi

exit 0
