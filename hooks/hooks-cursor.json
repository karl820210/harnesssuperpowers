{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "cmd /c \"%CURSOR_PLUGIN_ROOT%\\hooks\\run-hook.cmd\" session-start"
      }
    ],
    "afterFileEdit": [
      {
        "command": "cmd /c \"%CURSOR_PLUGIN_ROOT%\\hooks\\run-hook.cmd\" spec-sdd-check"
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "cmd /c \"%CURSOR_PLUGIN_ROOT%\\hooks\\run-hook.cmd\" spec-sdd-check"
      }
    ],
    "stop": [
      {
        "command": "cmd /c \"%CURSOR_PLUGIN_ROOT%\\hooks\\run-hook.cmd\" capture-knowhow-reminder"
      }
    ]
  }
}
